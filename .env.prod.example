# Template for the root-level .env used by docker-compose.prod.yml's
# ${VAR} substitution. Copy to .env (git-ignored) and fill in real values
# before running:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Secrets specific to the backend process itself (JWT_SECRET,
# ANTHROPIC_API_KEY, SMTP_*, FRONTEND_URL) still live in
# fiddlers_green-backend/.env, same as in dev — this file only covers
# what docker-compose.prod.yml itself needs to substitute.

# PostgreSQL credentials — choose real values, not the dev defaults
# (fg_user / fg_password) committed in docker-compose.yml.
POSTGRES_DB=fiddlers_green
POSTGRES_USER=
POSTGRES_PASSWORD=

# The production site URL, used both for the frontend's metadataBase and
# baked into the client bundle at build time.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# Leave empty unless the backend is NOT reachable at "same host, port
# 8000" in production (e.g. behind Nginx on a sub-path). See
# fiddlers_green-frontend/Dockerfile for the fallback behavior when unset.
NEXT_PUBLIC_BACKEND_URL=
